; $VER: Install-Speedy standalone-rc2 (6.11.2026)
; The Amiga Installer script for Speedy the Rollerskater, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the Speedy drawer where the archive was unpacked.

(set @app-name "Speedy the Rollerskater")
(set #version "standalone-rc2")
(set #drawer "Speedy")
(set #program "StartGame")
(set #space 292969)  ; KB

(onerror
    (message (cat "Speedy the Rollerskater was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-Speedy again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "Speedy the Rollerskater needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Speedy the Rollerskater needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Speedy the Rollerskater needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The Speedy drawer is not beside Install-Speedy. Unpack the whole archive, then run Install-Speedy from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The Speedy drawer has no StartGame in it. Unpack the whole archive again."))

(welcome "This installs Speedy the Rollerskater standalone-rc2 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; ---------------------------------------------------------------- the archive's own check
; package-standalone.sh writes game.zip.sha256 (a sha256sum list) beside game.zip: with
; Tools/SHA256 the Installer checks game.zip before anything is copied
(set #checker (tackon #from "Tools/SHA256"))
(set #sumlist (tackon #from "game.zip.sha256"))
(if (and (= (exists #checker (noreq)) 1) (= (exists #sumlist (noreq)) 1))
    (if
        (askbool
            (prompt "Check the SHA-256 of game.zip, Speedy the Rollerskater's data in this archive, before it is installed?")
            (help "The archive carries the SHA-256 of game.zip in game.zip.sha256. Tools/SHA256 reads game.zip and compares, which finds an archive damaged in the download or while it was unpacked. On a 68040 it takes a minute or two. Skip it if the archive was checked already.")
            (choices "Check it" "Skip the check")
            (default 1))
        (
            (working "Checking the SHA-256 of game.zip.")
            (set #sha-rc (run (cat "\"" #checker "\" CHECK=\"" #sumlist "\" >NIL:") (safe)))
            (if (<> #sha-rc 0)
                (abort "game.zip in this archive is damaged: its SHA-256 is not the one in game.zip.sha256. Download the archive again and unpack all of it. Nothing has been installed."))
            (message "The SHA-256 of game.zip matches the one the archive was made with.")
        )
    )
)

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the Speedy drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called Speedy in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": Speedy the Rollerskater needs 300 MB free.")))

; GFOpenGPU's modules: in LIBS:GFOpenGPU/, or copied there from LIBS:OpenGPU/
; (older instances have only that); none is copied before all are found
(if (and (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/GL.module" (noreq)) 1))
    (abort "Speedy the Rollerskater needs GFOpenGPU's GL.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-Speedy again. Nothing has been installed."))
(if (and (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1) (<> (exists "LIBS:OpenGPU/SDL2.module" (noreq)) 1))
    (abort "Speedy the Rollerskater needs GFOpenGPU's SDL2.module, which is in neither LIBS:GFOpenGPU/ nor LIBS:OpenGPU/. Install GFOpenGPU (SDL2) first, then run Install-Speedy again. Nothing has been installed."))
(if (<> (exists "LIBS:GFOpenGPU" (noreq)) 2)
    (makedir "LIBS:GFOpenGPU"))
(if (<> (exists "LIBS:GFOpenGPU/GL.module" (noreq)) 1)
    (copylib
        (prompt "Copying GL.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/GL.module")
        (dest "LIBS:GFOpenGPU")))
(if (<> (exists "LIBS:GFOpenGPU/SDL2.module" (noreq)) 1)
    (copylib
        (prompt "Copying SDL2.module from LIBS:OpenGPU/ to LIBS:GFOpenGPU/")
        (help @copylib-help)
        (source "LIBS:OpenGPU/SDL2.module")
        (dest "LIBS:GFOpenGPU")))
(complete 20)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying Speedy the Rollerskater")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating Speedy the Rollerskater. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "Speedy.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "Speedy.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Speedy the Rollerskater would have gone in " #dest "."))
    (message (cat "Speedy the Rollerskater standalone-rc2 is installed in " #dest "."
                  "\n\nTo start it, open the Speedy drawer and double-click the StartGame icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
